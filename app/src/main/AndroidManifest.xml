<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 12+ (API 31+) Bluetooth permissions. neverForLocation on SCAN since Mule
         Mode only needs to find nearby devices advertising our GATT service, not their
         physical location. Harmlessly ignored below API 31 (minSdk 24) rather than an error,
         so it's kept as-is rather than split into a separate API-31 manifest overlay. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:ignore="UnusedAttribute" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!-- Pre-Android-12 equivalents: install-time BLUETOOTH/BLUETOOTH_ADMIN plus the runtime
         location permission BLE scanning required before the API 31 permission model. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Android 13+ (API 33+) runtime permission to post/update the ongoing sync notification
         (PeripheralSyncService.updateNotification) — requested alongside the Bluetooth trio in
         MainActivity. Harmlessly ignored below API 33. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- FLAG_KEEP_SCREEN_ON (set on MainActivity's window) stops the *display timeout* from
         firing, but several OEM skins (seen on budget devices in particular) run their own
         battery-optimization/Doze-style policy that can still dim or lock the screen on an
         app they've decided is "inactive," ignoring that flag. Excluding this app from
         battery optimization (requested once at startup, see MainActivity) is the standard
         fix for that gap — required to even show that system prompt.

         Play Store Content Policy justification (lint's BatteryLife check flags this
         permission by default, since it's commonly abused): this app's core function is
         continuous phone-to-phone BLE mesh sync (PeripheralSyncService) plus staying on/awake
         as a race-timing clicker during an event — Doze suspending that background BLE
         radio/GATT server activity would silently break race data sync for however long the
         device is asleep, which is exactly the "app's core functionality is negatively
         impacted" carve-out the policy allows. tools:ignore suppresses the lint nag for this
         already-justified, deliberate use. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <application
        android:name=".RacemasterApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RacemasterMobile">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RacemasterMobile"
            android:windowSoftInputMode="adjustResize">
            <!-- Without this, the OS decides how to react to the keyboard on its own —
                 usually fine on a modern device (API 30+), where WindowInsets.ime is
                 dispatched reliably enough that Compose's own imePadding()/verticalScroll
                 handles it. Confirmed in the field on a Cubot running Android 8.1 (API 27,
                 well before WindowInsets.ime matured) that without this, the system instead
                 pans the *entire window* to keep a focused field above the keyboard — dragging
                 the TopAppBar (Cancel/title/HideKeyboardButton) off the top of the screen along
                 with everything else, since edge-to-edge (enableEdgeToEdge() in MainActivity)
                 means there's no OS-level concept of "this part is fixed" once the window itself
                 is what's moving. adjustResize is the low-level, OS-managed fallback that's
                 honored even when Compose's own WindowInsets-based keyboard handling isn't
                 reliable — it resizes the window's content area instead of panning the whole
                 thing, leaving anything genuinely fixed (the TopAppBar) exactly where it was. -->

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Android 14+ (API 34+) requires every foreground service to declare a type and, for
             restricted types like connectedDevice, a justification for Play Console review.
             Justification: this service runs a BLE GATT server/central pair that continuously
             advertises to and connects with other nearby race-timing phones to relay timing
             data (see STRUCTURE.md's Mule BLE protocol doc) — connectedDevice is the type Android
             defines for exactly this "interacting with a connected/companion Bluetooth device"
             case, and the corresponding FOREGROUND_SERVICE_CONNECTED_DEVICE permission above is
             the type-specific permission Android 14+ requires alongside it. -->
        <service
            android:name=".data.mule.PeripheralSyncService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="true" />
    </application>

</manifest>