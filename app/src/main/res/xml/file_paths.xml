<?xml version="1.0" encoding="utf-8"?>
<!-- Backs both RangeSampleLogger.shareIntent() and BleConnectionLog.shareIntent()'s
     FileProvider — the only files this app ever shares off-device, so this grants read access
     to just the app's internal files directory (where beacon-range-samples.csv and
     ble-connection-log.txt live), nothing broader. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="beacon-data" path="." />
</paths>
